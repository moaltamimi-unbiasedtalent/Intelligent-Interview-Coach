# =============================================================================
# Ask4Mo Capstone (P8) — STAGING environment template.
#
#   cp deploy/.env.staging.example deploy/.env.staging   # then fill real values
#
# deploy/.env.staging holds real secrets and is git-ignored. This .example file
# contains ONLY safe placeholders — NEVER commit a real key, password, or token.
# Every value below is a placeholder; replace <...> before deploying.
# =============================================================================

# --- Core runtime -----------------------------------------------------------
# development | test | staging | production. Staging is validated like production
# for CORS / DB / APP_BASE_URL, but email is a warning (not fatal) unless open
# registration is enabled.
API_ENV=staging

# Comma-separated exact allowlist of browser origins permitted by CORS.
# NO wildcards in hosted environments. Include the frontend origin (and any
# additional trusted origins). Same parent domain as the API keeps the session
# cookie SameSite=Lax.
FRONTEND_ORIGINS=https://app.staging.example.com

# Canonical public base URL of the app (used for links, cookies, OIDC redirect).
APP_BASE_URL=https://app.staging.example.com

# Public base URL of the API, consumed by the frontend build/run
# (NEXT_PUBLIC_API_BASE_URL) — include the /api/v1 base path.
NEXT_PUBLIC_API_BASE_URL=https://api.staging.example.com/api/v1

# Session signing/secret (opaque server-side tokens; a deployment secret is
# expected in hosted operation). Generate: `openssl rand -hex 32`.
SESSION_SECRET=<generate-with-openssl-rand-hex-32>

# Honour X-Forwarded-For ONLY behind a trusted proxy (Caddy sets it). Enables
# correct client IPs for rate limiting.
TRUST_PROXY=true

# --- Database (PostgreSQL 16) -----------------------------------------------
# Used by both compose Postgres and the app. Keep these three in sync with
# DATABASE_URL below.
POSTGRES_USER=ask4mo
POSTGRES_PASSWORD=<choose-a-strong-db-password>
POSTGRES_DB=ask4mo_staging

# SQLAlchemy/psycopg URL. Host `db` is the compose service name.
DATABASE_URL=postgresql+psycopg://ask4mo:<choose-a-strong-db-password>@db:5432/ask4mo_staging

# LangGraph durable HITL checkpoints. May reuse the same Postgres (a separate
# database/schema is also fine). Fail-closed durable checkpointing in hosted ops.
AGENT_CHECKPOINT_DATABASE_URL=postgresql+psycopg://ask4mo:<choose-a-strong-db-password>@db:5432/ask4mo_staging

# --- LLM (OpenRouter) -------------------------------------------------------
# Without this, Mo/LLM features are unavailable (warning, not fatal).
OPENROUTER_API_KEY=<openrouter-api-key>
# OpenRouter model slugs per workload profile (override without code changes).
OPENROUTER_MODEL_FAST=openai/gpt-5.6-luna
OPENROUTER_MODEL_BALANCED=openai/gpt-5.6-terra
OPENROUTER_MODEL_ADVANCED=openai/gpt-5.6-sol

# --- Email (Brevo) — required for OPEN verified-email registration ----------
# If you do NOT configure a real provider, you MUST pause public_registration
# (see PAUSED_CAPABILITIES) or staging will flag it.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=<brevo-api-key>
EMAIL_SENDER=no-reply@staging.example.com

# --- Google sign-in (optional; OFF unless fully configured) ------------------
FEATURE_GOOGLE_LOGIN=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Realtime voice (optional; OFF by default) ------------------------------
# Realtime is available ONLY when the flag is ON *and* a key is set; otherwise
# the app falls back to turn-based voice. The key stays server-side (mints
# short-lived ephemeral browser credentials) — never sent to the client.
REALTIME_VOICE_ENABLED=false
REALTIME_VOICE_API_KEY=
REALTIME_VOICE_MODEL=gpt-realtime

# --- Private document storage -----------------------------------------------
# Mounted durable volume (compose `documents` volume). NEVER a public bucket and
# never under the frontend public assets. Production-scale option: S3-compatible
# object storage (document the adapter/bucket separately).
DOCUMENT_STORAGE_DIR=/data/documents

# --- Malware scanning (fail-closed) -----------------------------------------
# When required, uploads are rejected if the scanner is unreachable (fail-closed).
MALWARE_SCAN_REQUIRED=true
FILE_SCAN_PROVIDER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- Rate limiting ----------------------------------------------------------
# In-memory (process-local) is correct for a SINGLE replica only. For multiple
# replicas set redis and provide a shared-store adapter (see the runbook).
RATE_LIMIT_BACKEND=in_memory

# --- Operator pause switch --------------------------------------------------
# Comma-separated capabilities paused at boot (e.g. public_registration,
# realtime_voice, external_research). Empty = nothing paused. Also togglable at
# runtime via POST /api/v1/admin/pause/{capability}.
PAUSED_CAPABILITIES=

# --- Optional current-market research (Adzuna) ------------------------------
EXTERNAL_RESEARCH_ENABLED=false
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Optional agent/interview feature flags ---------------------------------
AGENT_COACH_ENABLED=true
INTERVIEW_LIVE_ENABLED=false

# --- Optional external observability (Langfuse; OFF by default) -------------
AGENT_EXTERNAL_OBSERVABILITY_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Edge proxy (Caddy) domains / ACME --------------------------------------
# Consumed by deploy/Caddyfile via environment substitution.
APP_DOMAIN=app.staging.example.com
API_DOMAIN=api.staging.example.com
ACME_EMAIL=ops@example.com
