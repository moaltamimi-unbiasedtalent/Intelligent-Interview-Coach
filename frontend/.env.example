# Public frontend configuration only. NEVER put provider keys or server secrets
# here — all model/provider access stays in the Python backend.

# Base URL of the FastAPI backend (Sprint 4 Phase 2). Development default:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Local development identity ONLY. The backend treats this as a transitional
# X-User-Subject header for data scoping; it is NOT production authentication.
# Leave unset to use the backend's anonymous developer identity.
# NEXT_PUBLIC_DEV_USER_SUBJECT=
