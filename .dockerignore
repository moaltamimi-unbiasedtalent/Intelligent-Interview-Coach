# Never ship secrets, local state, or heavy build artefacts into the image.
.git
.gitignore
.venv
.venv.broken
**/__pycache__
*.pyc
*.egg-info
.pytest_cache
tests
data
*.db
.env
.env.*
.streamlit/secrets.toml
.claude
node_modules
components/live_interviewer/frontend/node_modules
components/live_interviewer/frontend/dist
docs
!docs/production/execution/language_readiness.json
evaluations

# Recursive exclusions also protect ordinary root-context builds; release builds
# additionally use git archive and cannot see untracked local files at all.
**/.env
**/.env.*
**/secrets.toml
**/node_modules
**/.next
**/.git
**/.DS_Store
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/*.pem
**/*.key
.codex
.agents
