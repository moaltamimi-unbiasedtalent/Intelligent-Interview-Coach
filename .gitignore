# Secrets and local environment — never commit these
.env
.streamlit/secrets.toml

# Virtual environments
.venv/
.venv.broken/
venv/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# IDE local settings
.vscode/
.idea/

# macOS
.DS_Store

# Generated temporary files
*.tmp
*.log
tmp/

# Editable-install metadata
*.egg-info/

# Local database (dev)
*.db
# Agent HITL checkpoint store (runtime-generated; SqliteSaver manages its own tables)
*.sqlite
*.sqlite-shm
*.sqlite-wal
# Knowledge base: keep the structure + docs, ignore generated stores and the
# (potentially large / licensed) source documents.
data/chroma/*
data/processed/*
data/raw/*
data/knowledge/*
data/knowledge_demo/
# Phase 7: canonical normalized build layer (generated from data/raw by the
# knowledge loaders) and the generated build-reproducibility metadata.
data/normalized/*
data/build_metadata.json
# Phase 7A.1: archived/quarantined duplicates and external API caches (generated,
# potentially large / licensed). The small dedup report at data/ root stays tracked.
data/_archive/
data/cache/
data/knowledge/canonical_id_registry.json
!data/raw/.gitkeep
!data/raw/README.md
!data/processed/.gitkeep
!data/chroma/.gitkeep
!data/knowledge/.gitkeep
!data/normalized/.gitkeep

# Local editor/launch config
.claude/

# RAGAS run artifacts are generated locally (may contain generated answers);
# never commit them. The public cases + README under evaluations/ragas/ stay tracked.
evaluations/ragas/runs/

# Live agent-eval run outputs are generated locally (recorded traces + judge summary);
# never commit them. The case definitions (evaluations/agent_live/cases.json) stay tracked.
evaluations/agent_live/traces/
evaluations/agent_live/judge_summary.json

# Phase 7C: regenerable retrieval-eval full outputs (summaries live in coverage_report.json)
evaluations/knowledge/retrieval_before.json
evaluations/knowledge/retrieval_after.json
