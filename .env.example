# Optional Adzuna current-market data integration
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Local development fallback only. Streamlit secrets take priority.
# Copy this file to .env and add your key. Never commit .env.
OPENROUTER_API_KEY=

# --- Speech-to-text (optional; enables recorded voice answers) ---------------
# Google Cloud Speech-to-Text V2 (Chirp 3). Set the project id to enable voice.
# GOOGLE_SPEECH_PROJECT_ID=your-gcp-project-id
# GOOGLE_SPEECH_LOCATION=global
#
# Credentials use Application Default Credentials. Point to a service-account
# JSON key file that you must NEVER commit:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# --- Live interview (optional, experimental; Gemini Live) --------------------
# The permanent Gemini key is used ONLY on the backend to mint short-lived
# ephemeral tokens; it is never sent to the browser. Never commit a real key.
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# --- Accounts & persistence (optional) ---------------------------------------
# Local development allows anonymous use; set true to require login (production).
# APP_AUTH_REQUIRED=false
# SQLite for dev; a PostgreSQL URL for production (never commit real credentials).
# DATABASE_URL=sqlite:///data/interview_studio.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# --- FastAPI backend (Sprint 4 Phase 2) --------------------------------------
# The API (uvicorn src.api.main:app) serves /api/v1 over the same application
# layer as Streamlit. These are non-secret settings.
# API_ENV=development
# Comma-separated allowed CORS origins for the future Next.js frontend.
# Production MUST set this; development defaults to http://localhost:3000.
# FRONTEND_ORIGINS=http://localhost:3000

# --- Model registry (OpenRouter workload profiles) ---------------------------
# The app resolves models through three workload profiles (src/llm/models.py).
# These are OpenRouter slugs and are the CURRENT defaults at implementation time —
# override per deployment to evolve models without code changes. Never a real key.
# OPENROUTER_MODEL_FAST=openai/gpt-5.6-luna       # bounded utility tasks
# OPENROUTER_MODEL_BALANCED=openai/gpt-5.6-terra  # default: agent, synthesis, structured
# OPENROUTER_MODEL_ADVANCED=openai/gpt-5.6-sol    # answer evaluation + final report

# --- Career Intelligence Copilot (RAG assistant) -----------------------------
# Reuses OPENROUTER_API_KEY above. Optional overrides:
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# COPILOT_MODEL=openai/gpt-5.6-terra   # overrides the Career default (Balanced profile)
# COPILOT_EMBEDDING_MODEL=text-embedding-3-small
# COPILOT_EMBEDDING_BASE_URL=https://api.openai.com/v1
# COPILOT_EMBEDDING_API_KEY=your-embeddings-key   # if embeddings use a different provider
# COPILOT_CHROMA_DIR=data/chroma
# COPILOT_DEBUG=false

# --- Agent Coach (Sprint 4 Phases 9–11) --------------------------------------
# Routes the candidate /prepare page to the LangGraph Agent Coach ("Mo"). Enabled here
# so the documented reviewer/demo path gets Mo out of the box; set to false for the
# deterministic Career flow (safe rollback). This flag only selects the /prepare
# experience — it does NOT affect authentication, which stays fail-closed in production
# regardless of this value.
AGENT_COACH_ENABLED=true
# Durable LangGraph HITL checkpoint DB (falls back to DATABASE_URL, then a dev sqlite
# file). Use an explicit URL to require durable checkpointing (fail-closed).
# AGENT_CHECKPOINT_DATABASE_URL=sqlite:///data/agent_checkpoints.sqlite

# --- Durable interview sessions / retention (Sprint 4 Phases 10–11) -----------
# Retention window for stale IN-PROGRESS interview sessions (completed history is
# never auto-deleted). Used by scripts/cleanup_runtime_data.py.
# INTERVIEW_SESSION_RETENTION_DAYS=30

# --- Live interview flag (experimental; OFF by default) -----------------------
# INTERVIEW_LIVE_ENABLED=false

# --- RAGAS answer-quality evaluator (optional, paid; opt-in only) -------------
# Used only by `python scripts/eval_ragas.py --live`. Separate evaluator key — never
# printed. Nothing spends money unless --live is passed explicitly.
# RAGAS_EVAL_API_KEY=your-evaluator-key
# RAGAS_EVAL_BASE_URL=https://openrouter.ai/api/v1
# RAGAS_EVAL_MODEL=openai/gpt-5.6-terra
# RAGAS_EVAL_EMBEDDING_MODEL=text-embedding-3-small

# --- Optional external observability: Langfuse (Phase 7D; OFF by default) ------
# Provider-neutral telemetry. Default is a no-op with NO external network. Opt in by
# setting the flag AND both keys; the sink then emits ONLY sanitised operational
# metadata (never prompts, candidate content, memory, checkpoints, CoT or secrets).
# See docs/observability.md.
AGENT_EXTERNAL_OBSERVABILITY_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# Trace sampling in [0.0, 1.0] (default 1.0 — telemetry is metadata-only).
# LANGFUSE_SAMPLE_RATE=1.0
# Content capture stays OFF in Phase 7D; the sanitizer still runs if ever enabled.
# LANGFUSE_CAPTURE_CONTENT=false
# Optional server-side salt to emit a NON-REVERSIBLE pseudonymous user id for trace
# correlation. Without it, telemetry correlates by opaque run/session ids only.
# OBSERVABILITY_ID_SALT=
# Optional explicit release/version tag for traces (else resolved from package/git once).
# ASK4MO_RELEASE=
